{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RsaKeys": {
    "PublicKeyPath": "../Keys/public.pem"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-cadastrar": {
        "ClusterId": "autenticacao-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/auth/cadastrar"
        }
      },
      "auth-login": {
        "ClusterId": "autenticacao-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/auth/login"
        }
      },
      "auth-protected": {
        "ClusterId": "autenticacao-cluster",
        "AuthorizationPolicy": "authenticated",
        "Order": 2,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "contacorrente": {
        "ClusterId": "contacorrente-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/contacorrente/{**catch-all}"
        }
      },
      "saldo": {
        "ClusterId": "contacorrente-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/saldo/{**catch-all}"
        }
      },
      "caixa": {
        "ClusterId": "caixa-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/caixa/{**catch-all}"
        }
      },
      "transferencia": {
        "ClusterId": "transferencia-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/transferencia/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "autenticacao-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5027"
          }
        }
      },
      "contacorrente-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5024"
          }
        }
      },
      "transferencia-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5025"
          }
        }
      },
      "caixa-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5028"
          }
        }
      }
    }
  }
}
